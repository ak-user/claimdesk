# Copy to backend/.env. With nothing set, ClaimDesk runs on its offline planner.

# --- Azure OpenAI -------------------------------------------------------------------------
# Endpoint like https://<resource-name>.openai.azure.com and the deployment names you created.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Leave the key empty to sign in with Microsoft Entra ID instead
# (`az login` locally, a managed identity in Azure). Needs: pip install -e ".[azure]"
AZURE_OPENAI_API_KEY=

# --- OpenAI, if you don't use Azure -------------------------------------------------------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=

# --- App ----------------------------------------------------------------------------------
# The demo data is dated, so "today" is fixed. Change it to test deadlines and windows.
CLAIMDESK_AS_OF=2026-10-26
# SQLite file for the examiner queue, e.g. claimdesk.db. ":memory:" forgets it on restart.
CLAIMDESK_DB_PATH=:memory:

# Requests per minute per client to /api/ask and the claim routes. 0 turns the limit off.
CLAIMDESK_RATE_LIMIT_PER_MINUTE=30
